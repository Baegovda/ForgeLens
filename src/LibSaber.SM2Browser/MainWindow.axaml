<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tdg="using:Avalonia.Controls"
        xmlns:local="using:LibSaber.SM2Browser"
        xmlns:gpu="using:LibSaber.SM2Browser.Gpu"
        xmlns:cb="using:LibSaber.SM2Browser.ContentBrowser"
        x:Class="LibSaber.SM2Browser.MainWindow"
        Title="Forge Lens — Space Marine 2 assets"
        Width="1440"
        Height="800"
        MinWidth="1100"
        MinHeight="640">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="10,8" Background="{DynamicResource FL.Toolbar}" BorderBrush="{DynamicResource FL.Border}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button x:Name="OpenButton" Content="Open game folder" Click="OpenClicked" Margin="0,0,8,0" ToolTip.Tip="The game root or client_pc. Caches are found in subfolders." />
        <TextBlock x:Name="FolderText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="PrefixCharacterEllipsis" Margin="4,0,12,0" Foreground="{DynamicResource FL.TextDim}" ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        <Button x:Name="ExportButton" Grid.Column="2" Content="Export…" Classes="accent" Click="ExportClicked" IsEnabled="False" Margin="8,0,0,0" MinWidth="140"
                ToolTip.Tip="Select files in the list or grid first (Ctrl/Shift for several). Ctrl+E" />
      </Grid>
    </Border>
    <Border DockPanel.Dock="Bottom" Padding="10,5" Background="{DynamicResource FL.Toolbar}" BorderBrush="{DynamicResource FL.Border}" BorderThickness="0,1,0,0">
      <TextBlock x:Name="StatusText" Foreground="{DynamicResource FL.TextDim}" FontSize="12" TextTrimming="CharacterEllipsis" Text="Open the game folder (the one that contains the .pak files)." />
    </Border>
    <Grid x:Name="MainColumns" ColumnDefinitions="250,6,1.35*,6,2*">
      <!-- ui-43 Content Browser left pane: Favorites, Folders | Categories tree, Collections (all remembered). -->
      <Grid x:Name="LeftPane" Grid.Column="0" MinWidth="170" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Background="{DynamicResource FL.PanelDeep}">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="8,6,4,2">
          <TextBlock Text="FAVORITES" Classes="header" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="mini" Content="★ Pin" Click="PinFolderClicked" ToolTip.Tip="Pin the selected folder to Favorites" />
        </Grid>
        <ListBox x:Name="FavoritesList" Grid.Row="1" MaxHeight="132" SelectionChanged="FavoriteSelected">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="cb:FavoriteItem">
              <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{Binding Tip}">
                <TextBlock Text="★" Foreground="{DynamicResource FL.Accent}" FontSize="11" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="FavoritesEmpty" Grid.Row="1" Text="Pin folders with ★ or right-click a folder." FontSize="11" Margin="10,2,8,6" Foreground="{DynamicResource FL.TextDim}" TextWrapping="Wrap" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="2" Margin="6,6,6,2">
          <Button x:Name="FoldersTab" Classes="tab" Content="Folders" Click="FoldersTabClicked" ToolTip.Tip="Archive folders" />
          <Button x:Name="CategoriesTab" Classes="tab" Content="Categories" Click="CategoriesTabClicked"
                  ToolTip.Tip="Assets grouped from game data (.cls classes, Morpheme bundles, folders). Nodes marked H use name rules (HEURISTIC). Everything is under All; anything unplaced is under Other." />
        </StackPanel>
        <Grid Grid.Row="3">
          <tdg:TreeDataGrid x:Name="FolderTree" MinWidth="160" Background="{DynamicResource FL.PanelDeep}" />
          <TreeView x:Name="CategoryTree" IsVisible="False" SelectionChanged="CategorySelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <TreeView.Styles>
              <Style Selector="TreeViewItem" x:DataType="cb:CategoryItem">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="MinHeight" Value="26" />
              </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
              <TreeDataTemplate x:DataType="cb:CategoryItem" ItemsSource="{Binding Children}">
                <Grid ColumnDefinitions="*,Auto,Auto" ToolTip.Tip="{Binding Tip}">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Classes="hbadge" IsVisible="{Binding Heuristic}" Margin="4,0,0,0"><TextBlock Text="H" FontSize="9" /></Border>
                  <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="11" Margin="6,0,2,0" Foreground="{DynamicResource FL.TextDim}" VerticalAlignment="Center" />
                </Grid>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
          <TextBlock x:Name="CategoryStatus" IsVisible="False" Margin="10" TextWrapping="Wrap" Foreground="{DynamicResource FL.TextDim}" />
        </Grid>
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="8,6,4,2">
          <TextBlock Text="COLLECTIONS" Classes="header" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="mini" Content="＋ New" Click="NewCollectionClicked" ToolTip.Tip="New collection (adds the selected assets, if any)" />
        </Grid>
        <ListBox x:Name="CollectionsList" Grid.Row="5" MaxHeight="220" MinHeight="40" SelectionChanged="CollectionSelected" DragDrop.AllowDrop="True">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="cb:CollectionItem">
              <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent">
                <Ellipse Width="9" Height="9" Fill="{Binding Brush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="11" Margin="6,0,0,0" Foreground="{DynamicResource FL.TextDim}" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
      <GridSplitter Grid.Column="1" Width="4" Background="{DynamicResource FL.Border}" ResizeDirection="Columns" />
      <DockPanel Grid.Column="2" MinWidth="220">
        <!-- ui-43 browser bar: Files / Recent, scope, search; type chips, subfolders / all files, Grid | List, tile size. -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="8,6,8,0">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button x:Name="FilesTab" Classes="tab" Content="Files" Click="FilesTabClicked" />
            <Button x:Name="RecentTab" Classes="tab" Content="Recent" Click="RecentTabClicked" />
          </StackPanel>
          <TextBlock x:Name="ScopeText" Grid.Column="1" VerticalAlignment="Center" Margin="10,0" FontWeight="SemiBold" TextTrimming="PrefixCharacterEllipsis"
                     ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}" />
          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <TextBox x:Name="SearchBox" Watermark="Search (Ctrl+F)" Width="190" TextChanged="SearchChanged" KeyDown="SearchKeyDown"
                     ToolTip.Tip="Words separated by spaces must all match the path. Folders: searches every archive. Categories / collections: searches inside the selected node. Enter previews the first result, Down moves into the list, Esc clears." />
            <Button x:Name="SearchClear" Content="✕" Click="SearchClearClicked" IsVisible="False" Padding="6,2" Margin="2,0,0,0" ToolTip.Tip="Clear search (Esc)" />
          </StackPanel>
        </Grid>
        <StackPanel x:Name="FileHeader" DockPanel.Dock="Top" Margin="0,4,0,0">
          <WrapPanel Orientation="Horizontal" Margin="8,0">
            <WrapPanel.Styles>
              <Style Selector="WrapPanel > :is(Control)">
                <Setter Property="Margin" Value="0,0,4,4" />
              </Style>
            </WrapPanel.Styles>
            <ToggleButton x:Name="ChipAll" Classes="chip" Content="All" Tag="0" Click="ChipClicked" />
            <ToggleButton x:Name="ChipModels" Classes="chip model" Content="Models" Tag="2" Click="ChipClicked" />
            <ToggleButton x:Name="ChipAnims" Classes="chip anim" Content="Animations" Tag="3" Click="ChipClicked" />
            <ToggleButton x:Name="ChipEffects" Classes="chip fx" Content="Effects" Tag="4" Click="ChipClicked" />
            <ToggleButton x:Name="ChipTextures" Classes="chip tex" Content="Textures" Tag="1" Click="ChipClicked" />
            <ToggleButton x:Name="ChipText" Classes="chip" Content="Text / YAML" Tag="5" Click="ChipClicked" />
            <ComboBox x:Name="FilterBox" SelectedIndex="0" SelectionChanged="FilterChanged" IsVisible="False">
              <ComboBoxItem Content="All types" />
              <ComboBoxItem Content="Textures" />
              <ComboBoxItem Content="Models" />
              <ComboBoxItem Content="Animations" />
              <ComboBoxItem Content="Effects" />
              <ComboBoxItem Content="Text / YAML" />
            </ComboBox>
          </WrapPanel>
          <WrapPanel Orientation="Horizontal" Margin="8,0">
            <WrapPanel.Styles>
              <Style Selector="WrapPanel > :is(Control)">
                <Setter Property="Margin" Value="0,0,6,4" />
                <Setter Property="VerticalAlignment" Value="Center" />
              </Style>
            </WrapPanel.Styles>
            <ToggleButton x:Name="GridViewButton" Classes="chip" Content="▦ Grid" Click="GridViewClicked" ToolTip.Tip="Thumbnail grid" />
            <ToggleButton x:Name="ListViewButton" Classes="chip" Content="☰ List" Click="ListViewClicked" ToolTip.Tip="Detail list (resizable columns)" />
            <Slider x:Name="TileSizeSlider" Width="96" Minimum="64" Maximum="256" Value="112" VerticalAlignment="Center" ValueChanged="TileSizeChanged" ToolTip.Tip="Tile size" />
            <CheckBox x:Name="AnimateAllBox" Content="Animate all" Click="AnimateAllChanged" ToolTip.Tip="Loop every animation / effect thumbnail on screen (off: only the one under the mouse)" />
            <CheckBox x:Name="SubfoldersBox" Content="Include subfolders" Click="SubfoldersChanged" ToolTip.Tip="List every file under the selected folder." />
            <CheckBox x:Name="ShowAllBox" Content="Show all files" Click="ShowAllChanged"
                        ToolTip.Tip="Off: only assets the preview can show (.tpl models, textures, .sani clips, .sfx effects). On: also .tpl_data, .tpl_markup, .lods_base, .geom_dbg, .resource, mips and text. A type filter other than All always lists that whole type." />
          </WrapPanel>
          <!-- mtl1-42: drag the header splitters to resize; PATH takes the rest. Widths are remembered across runs. -->
          <Grid x:Name="FileColumnHeader" ColumnDefinitions="*,6,72,6,64,6,112" Margin="8,2,8,2" Height="22">
            <TextBlock Text="PATH" Classes="header" VerticalAlignment="Center" />
            <GridSplitter Grid.Column="1" Classes="column" ResizeDirection="Columns" ToolTip.Tip="Drag to resize" />
            <TextBlock Grid.Column="2" Text="TYPE" Classes="header" VerticalAlignment="Center" />
            <GridSplitter Grid.Column="3" Classes="column" ResizeDirection="Columns" ToolTip.Tip="Drag to resize" />
            <TextBlock Grid.Column="4" Text="SIZE" Classes="header" VerticalAlignment="Center" />
            <GridSplitter Grid.Column="5" Classes="column" ResizeDirection="Columns" ToolTip.Tip="Drag to resize" />
            <TextBlock Grid.Column="6" Text="ARCHIVE" Classes="header" VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
        <Grid>
        <ListBox x:Name="FileList" SelectionMode="Multiple" SelectionChanged="FileSelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="local:FileRow">
              <Grid ColumnDefinitions="*,6,Auto,6,Auto,6,Auto">
                <!-- Middle ellipsis: folders in the middle collapse first, the file name stays readable. Full path on hover. -->
                <TextBlock Text="{Binding Path}" TextTrimming="PrefixCharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                <TextBlock Grid.Column="2" Text="{Binding Extension}" Foreground="{DynamicResource FL.TextDim}" TextTrimming="CharacterEllipsis"
                           Width="{ReflectionBinding TypeWidth, Source={x:Static local:FileColumns.Shared}}" />
                <TextBlock Grid.Column="4" Text="{Binding SizeText}" Foreground="{DynamicResource FL.TextDim}" TextAlignment="Right" Padding="0,0,8,0"
                           Width="{ReflectionBinding SizeWidth, Source={x:Static local:FileColumns.Shared}}" />
                <TextBlock Grid.Column="6" Text="{Binding Archive}" Foreground="{DynamicResource FL.TextDim}" TextTrimming="PrefixCharacterEllipsis" ToolTip.Tip="{Binding Archive}"
                           Width="{ReflectionBinding ArchiveWidth, Source={x:Static local:FileColumns.Shared}}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <ListBox x:Name="TileGrid" Classes="tiles" IsVisible="False" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Background="{DynamicResource FL.PanelDeep}" Padding="2,4">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="cb:TileRow">
              <cb:TileRowPanel />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="EmptyText" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center" Foreground="{DynamicResource FL.TextDim}" />
        <ListBox x:Name="RecentList" IsVisible="False" SelectionChanged="RecentSelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="local:RecentEntry">
              <StackPanel Margin="0,2">
                <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Archive}" Opacity="0.7" FontSize="11" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        </Grid>
      </DockPanel>
      <GridSplitter Grid.Column="3" Width="4" Background="{DynamicResource FL.Border}" ResizeDirection="Columns" />
      <Grid x:Name="ViewerColumns" Grid.Column="4" ColumnDefinitions="*,6,240" MinWidth="320">
      <DockPanel Grid.Column="0" Margin="8,8,4,8" MinWidth="280">
        <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal">
          <WrapPanel.Styles>
            <Style Selector="WrapPanel > :is(Control)">
              <Setter Property="Margin" Value="0,0,6,4" />
            </Style>
          </WrapPanel.Styles>
          <TextBlock Text="Mip" VerticalAlignment="Center" Foreground="{DynamicResource FL.TextDim}" />
          <ComboBox x:Name="MipBox" Width="64" SelectionChanged="MipChanged" />
          <TextBlock Text="Face" VerticalAlignment="Center" Foreground="{DynamicResource FL.TextDim}" />
          <ComboBox x:Name="FaceBox" Width="64" SelectionChanged="MipChanged" />
          <TextBlock x:Name="LodLabel" Text="LOD" VerticalAlignment="Center" IsVisible="False" Foreground="{DynamicResource FL.TextDim}" />
          <local:WheelComboBox x:Name="LodBox" Width="150" IsVisible="False" SelectionChanged="LodChanged" />
          <TextBlock x:Name="PartLabel" Text="Part" VerticalAlignment="Center" IsVisible="False" Foreground="{DynamicResource FL.TextDim}" />
          <local:WheelComboBox x:Name="PartBox" Width="220" IsVisible="False" SelectionChanged="ViewChanged" />
          <ToggleButton x:Name="WireToggle" Content="Wireframe" IsChecked="False" IsVisible="False" Click="ViewChanged" />
          <ToggleButton x:Name="SkeletonToggle" Content="Skeleton" IsChecked="False" IsVisible="False" Click="ViewChanged" />
          <ToggleButton x:Name="SmoothToggle" Content="AA" IsChecked="True" IsVisible="False" Click="ViewChanged"
                        ToolTip.Tip="2x2 supersampling on still frames (drag and playback render 1x)" />
          <ToggleButton x:Name="GpuToggle" Content="GPU" IsChecked="True" IsVisible="False" Click="GpuToggled"
                        ToolTip.Tip="GPU preview (OpenGL ES via ANGLE/Direct3D 11, 8x MSAA, GPU skinning). Off = CPU renderer, which also takes over by itself if the GPU path fails." />
          <Button x:Name="PlayButton" Content="Play" IsVisible="False" Click="PlayClicked" ToolTip.Tip="Space: play / pause" />
          <TextBlock x:Name="RenderStats" VerticalAlignment="Center" Opacity="0.7" FontSize="11" />
        </WrapPanel>
        <WrapPanel x:Name="AnimBar" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,2,0,0" IsVisible="False">
          <WrapPanel.Styles>
            <Style Selector="WrapPanel > :is(Control)">
              <Setter Property="Margin" Value="0,0,6,4" />
            </Style>
          </WrapPanel.Styles>
          <TextBlock Text="ANIM" Classes="section" />
          <TextBox x:Name="AnimFilter" Width="180" Watermark="Filter clips" TextChanged="AnimFilterChanged"
                   ToolTip.Tip="Substring, case-insensitive. Clips named after this model are listed first." />
          <local:WheelComboBox x:Name="AnimBox" Width="360" SelectionChanged="AnimChanged"
                    ToolTip.Tip="Mouse wheel over the closed box: previous / next clip of the (filtered) list, and it plays." />
          <Slider x:Name="ScrubSlider" Width="180" Minimum="0" Maximum="1" IsEnabled="False" ValueChanged="ScrubChanged" />
          <TextBlock x:Name="ScrubLabel" VerticalAlignment="Center" Text="0.00s" />
          <CheckBox x:Name="InPlaceToggle" Content="In place" IsChecked="True" Click="ViewChanged"
                    ToolTip.Tip="Rebase the clip so its first frame stands where the bind pose does (cinematic clips stay in view)" />
          <CheckBox x:Name="PhysicsToggle" Content="Physics" IsChecked="True" Click="ViewChanged" IsVisible="False"
                    ToolTip.Tip="Cloth (purity seals, tabards) and jiggle bones from the character class, simulated on the playing clip (GPU preview)" />
        </WrapPanel>
        <WrapPanel x:Name="HostVfxBar" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,2,0,0" IsVisible="False">
          <WrapPanel.Styles>
            <Style Selector="WrapPanel > :is(Control)">
              <Setter Property="Margin" Value="0,0,6,4" />
            </Style>
          </WrapPanel.Styles>
          <TextBlock Text="VFX ON MODEL" Classes="section" />
          <TextBox x:Name="HostVfxName" Width="220" Watermark="effect, e.g. fx_bolter_muzzle_client"
                   ToolTip.Tip=".sfx name. Emitters, lights and trails go on their nameParent bone (tip, jet_big_l, sfx_*); the rest on the socket at the right." />
          <ComboBox x:Name="HostVfxSocket" Width="200" SelectionChanged="HostVfxOptionsChanged"
                    ToolTip.Tip="Root socket for the parts without a nameParent of this model (Auto = model origin)" />
          <Button Content="Attach" Click="HostVfxAttachClicked" />
          <Button Content="Clear" Click="HostVfxClearClicked" />
          <CheckBox x:Name="HostVfxLoopToggle" Content="Loop" IsChecked="True" Click="HostVfxOptionsChanged"
                    ToolTip.Tip="On: the attached effect replays on its own clock. Off: it follows the clip time (scrub)." />
          <CheckBox x:Name="HostVfxEventsToggle" Content="Anim events" Click="HostVfxOptionsChanged"
                    ToolTip.Tip="Play the effects the clip's morpheme events start (event track -> blueprint .sso BlueprintNodeBulkVfxOnMorphemeEvents / OnMrEvent -> VfxRestart / StartSfx)" />
          <TextBox x:Name="HostVfxFilter" Width="150" Watermark="blueprints, e.g. power_sword"
                   ToolTip.Tip="Comma-separated blueprint name filters (the weapon / character the clip belongs to). Empty = every blueprint." />
          <TextBlock x:Name="HostVfxStatus" VerticalAlignment="Center" Opacity="0.75" FontSize="11" MaxWidth="900" TextTrimming="CharacterEllipsis" />
        </WrapPanel>
        <WrapPanel x:Name="VfxBar" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,2,0,0" IsVisible="False">
          <WrapPanel.Styles>
            <Style Selector="WrapPanel > :is(Control)">
              <Setter Property="Margin" Value="0,0,6,4" />
            </Style>
          </WrapPanel.Styles>
          <TextBlock Text="VFX" Classes="section" />
          <Button Content="Restart" Focusable="False" Click="VfxRestartClicked" ToolTip.Tip="Replay from 0 s (same seed: every run is identical)" />
          <Button Content="Fit" Focusable="False" Click="VfxFitClicked" ToolTip.Tip="Frame the whole effect (pre-simulated over its first run). Shortcut: F" />
          <Slider x:Name="VfxScrub" Width="220" Minimum="0" Maximum="1" ValueChanged="VfxScrubChanged"
                  ToolTip.Tip="Scrub: the fixed 60 Hz simulation replays deterministically to this time" />
          <TextBlock x:Name="VfxTime" VerticalAlignment="Center" Text="0.00s" />
          <CheckBox x:Name="VfxLoopToggle" Content="Loop" IsChecked="True" Click="VfxOptionsChanged" />
          <CheckBox x:Name="VfxGroundToggle" Content="Ground" IsChecked="True" Click="VfxOptionsChanged" />
          <ComboBox x:Name="VfxCoveringBox" SelectedIndex="1" IsVisible="False" SelectionChanged="VfxCoveringChanged"
                    ToolTip.Tip="DEMO / HEURISTIC: shows em_covering_* on a built-in host surface (painted where particles land). Not game-accurate.">
            <ComboBoxItem Content="Covering demo: off" />
            <ComboBoxItem Content="Covering demo: plane (heuristic)" />
            <ComboBoxItem Content="Covering demo: sphere (heuristic)" />
          </ComboBox>
        </WrapPanel>
        <TextBlock x:Name="PreviewNote" DockPanel.Dock="Bottom" TextWrapping="Wrap" MaxLines="5" TextTrimming="CharacterEllipsis" Margin="2,8,2,0" Foreground="{DynamicResource FL.TextDim}" FontSize="12"
                   ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        <Border x:Name="ViewBorder" Background="{DynamicResource FL.Viewport}" CornerRadius="4" BorderBrush="{DynamicResource FL.Border}" BorderThickness="1" ClipToBounds="True"
                PointerPressed="ViewPressed" PointerMoved="ViewMoved" PointerReleased="ViewReleased" PointerWheelChanged="ViewWheel">
          <Grid>
            <gpu:GpuPreviewControl x:Name="GpuView" IsVisible="False" />
            <Image x:Name="PreviewImage" Stretch="Uniform" />
            <TextBox x:Name="PreviewText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                     FontFamily="Consolas,Courier New,monospace" FontSize="12" Background="Transparent" BorderThickness="0" />
            <Border x:Name="LoadingOverlay" IsVisible="False" Background="#CC121418">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <ProgressBar IsIndeterminate="True" Width="200" Height="8" />
                <TextBlock Text="Loading..." HorizontalAlignment="Center" FontSize="16" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </DockPanel>
      <GridSplitter Grid.Column="1" Width="4" Background="{DynamicResource FL.Border}" ResizeDirection="Columns" />
      <DockPanel Grid.Column="2" Margin="4,8,8,8">
        <!-- ui-44: MESHES | KITBASH tabs share the right column. -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="2" Margin="0,0,0,4">
          <Button x:Name="MeshesTab" Classes="tab active" Content="Meshes" Click="MeshesTabClicked" ToolTip.Tip="Objects of the previewed model (check to show)" />
          <Button x:Name="KitbashTab" Classes="tab" Content="⚒ Kitbash" Click="KitbashTabClicked"
                  ToolTip.Tip="Kitbasher: pick a faction, class and preset, then one armor part per slot from the character customization library. Only the chosen parts show and export." />
        </StackPanel>
        <Grid>
        <ScrollViewer x:Name="KitbashPanel" IsVisible="False" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource FL.PanelDeep}">
          <StackPanel Margin="8,6,10,10" Spacing="6">
            <TextBlock Text="KITBASHER" Classes="header" />
            <TextBlock x:Name="KitbashIntro" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource FL.TextDim}"
                       Text="Parts from ssl/body/customization/character_customization_library.sso (class regions + shared outfit parts)." />
            <Grid ColumnDefinitions="64,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
              <TextBlock Grid.Row="0" Text="Faction" Classes="kblabel" />
              <ComboBox x:Name="KitbashTeamBox" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,0,0,4" SelectionChanged="KitbashTeamChanged" />
              <TextBlock Grid.Row="1" Text="Class" Classes="kblabel" />
              <ComboBox x:Name="KitbashClassBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,0,0,4" SelectionChanged="KitbashClassChanged" />
              <TextBlock Grid.Row="2" Text="Preset" Classes="kblabel" />
              <ComboBox x:Name="KitbashPresetBox" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="KitbashPresetChanged" />
            </Grid>
            <Border Classes="kbcard">
              <StackPanel Spacing="2">
                <TextBlock x:Name="KitbashTemplate" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="KitbashModelState" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource FL.TextDim}" />
              </StackPanel>
            </Border>
            <WrapPanel>
              <CheckBox x:Name="KitbashClassOnlyBox" Content="This class only" IsChecked="True" Click="KitbashFilterChanged" Margin="0,0,10,0"
                        ToolTip.Tip="On: shared outfit parts only when they are for all characters or list this class in appearanceUids (PVE_PVP_X = PVP_X). Off: every shared part of the faction." />
              <CheckBox x:Name="KitbashMissingBox" Content="Parts not in model" Click="KitbashFilterChanged"
                        ToolTip.Tip="Also list parts whose objects are not in the loaded tpl (marked ⚠; they show nothing). Equipment actors such as combat shields are separate models." />
            </WrapPanel>
            <TextBlock Text="PARTS" Classes="section" Margin="0,4,0,0" />
            <StackPanel x:Name="KitbashSlotsPanel" Spacing="4" />
            <TextBlock x:Name="KitbashEmpty" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource FL.TextDim}" IsVisible="False" />
            <WrapPanel Margin="0,6,0,0">
              <Button Content="Preset parts" Click="KitbashResetClicked" Margin="0,0,6,6" ToolTip.Tip="Back to the regions of the chosen preset" />
              <Button Content="Randomize" Click="KitbashRandomClicked" Margin="0,0,6,6" ToolTip.Tip="One random part per slot from the listed options" />
            </WrapPanel>
            <Button x:Name="KitbashExportButton" Content="Export combination…" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="KitbashExportClicked"
                    ToolTip.Tip="Exports the class tpl with exactly this combination (same ArmorVariant filter as the preview; --variant spec shown below)." />
            <SelectableTextBlock x:Name="KitbashSpec" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource FL.TextDim}" FontFamily="Consolas,Courier New,monospace" />
            <TextBlock x:Name="KitbashNotes" FontSize="11" TextWrapping="Wrap" Foreground="#E0B060" />
          </StackPanel>
        </ScrollViewer>
        <TreeView x:Name="MeshList" Background="{DynamicResource FL.PanelDeep}">
          <TreeView.ItemTemplate>
            <TreeDataTemplate x:DataType="local:MeshToggle" ItemsSource="{Binding Children}">
              <CheckBox IsChecked="{Binding Visible}" ToolTip.Tip="{Binding Tip}" Margin="2,1">
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
              </CheckBox>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
        </Grid>
      </DockPanel>
      </Grid>
    </Grid>
  </DockPanel>
</Window>

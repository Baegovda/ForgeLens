<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LibSaber.SM2Browser.App"
             RequestedThemeVariant="Dark">
  <!-- Forge Lens dark theme: neutral greys + one accent (#E8892B). Visual only; no behaviour lives here. -->
  <Application.Resources>
    <SolidColorBrush x:Key="FL.Bg" Color="#1E1F22" />
    <SolidColorBrush x:Key="FL.Panel" Color="#252629" />
    <SolidColorBrush x:Key="FL.PanelDeep" Color="#1A1B1E" />
    <SolidColorBrush x:Key="FL.Toolbar" Color="#2B2C30" />
    <SolidColorBrush x:Key="FL.Viewport" Color="#151618" />
    <SolidColorBrush x:Key="FL.Border" Color="#3A3C41" />
    <SolidColorBrush x:Key="FL.Control" Color="#323337" />
    <SolidColorBrush x:Key="FL.ControlHover" Color="#3C3D42" />
    <SolidColorBrush x:Key="FL.Text" Color="#DCDDDF" />
    <SolidColorBrush x:Key="FL.TextDim" Color="#9A9CA2" />
    <SolidColorBrush x:Key="FL.Accent" Color="#E8892B" />
    <SolidColorBrush x:Key="FL.AccentSoft" Color="#4DE8892B" />
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#E8892B" AltHigh="#1E1F22" AltMedium="#252629" AltMediumLow="#2B2C30"
                               BaseHigh="#DCDDDF" BaseMedium="#9A9CA2" ChromeMedium="#2B2C30" ChromeLow="#1A1B1E"
                               RegionColor="#1E1F22" ListLow="#2E2F33" ListMedium="#383A3E" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <!-- Without this include the folder grid has no template and draws as an empty pane. -->
    <StyleInclude Source="avares://Avalonia.Controls.TreeDataGrid/Themes/Fluent.axaml" />

    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource FL.Bg}" />
      <Setter Property="FontFamily" Value="Segoe UI, Inter, sans-serif" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource FL.Text}" />
    </Style>
    <Style Selector="Button, ToggleButton">
      <Setter Property="Background" Value="{DynamicResource FL.Control}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FL.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter, ToggleButton:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FL.ControlHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FL.Accent}" />
    </Style>
    <Style Selector="ToggleButton:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FL.AccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FL.Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource FL.Text}" />
    </Style>
    <Style Selector="TextBox, ComboBox">
      <Setter Property="Background" Value="{DynamicResource FL.PanelDeep}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FL.Border}" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style Selector="ListBox, TreeView">
      <Setter Property="Background" Value="{DynamicResource FL.PanelDeep}" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="MinHeight" Value="24" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FL.AccentSoft}" />
    </Style>
    <Style Selector="TreeViewItem">
      <Setter Property="MinHeight" Value="24" />
    </Style>
    <Style Selector="GridSplitter">
      <Setter Property="Background" Value="{DynamicResource FL.Border}" />
    </Style>
    <Style Selector="GridSplitter:pointerover">
      <Setter Property="Background" Value="{DynamicResource FL.Accent}" />
    </Style>
    <!-- mtl1-42: file list header splitters: a thin centred rule, accent on hover. -->
    <Style Selector="GridSplitter.column">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="SizeWestEast" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}">
            <Border Width="1" Margin="0,3" Background="{DynamicResource FL.Border}" HorizontalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="GridSplitter.column:pointerover">
      <Setter Property="Background" Value="{DynamicResource FL.AccentSoft}" />
    </Style>
    <!-- Files / Recent: flat tabs with an accent underline on the active one. -->
    <Style Selector="Button.tab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource FL.TextDim}" />
      <Setter Property="Padding" Value="12,4" />
    </Style>
    <Style Selector="Button.tab:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FL.Control}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FL.Border}" />
      <Setter Property="Foreground" Value="{DynamicResource FL.Text}" />
    </Style>
    <Style Selector="Button.tab.active">
      <Setter Property="BorderBrush" Value="{DynamicResource FL.Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource FL.Text}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.tab.active:pointerover /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource FL.Accent}" />
    </Style>
    <!-- Section label at the start of a viewer toolbar row (VFX, Anim, ...). -->
    <Style Selector="TextBlock.section">
      <Setter Property="Foreground" Value="{DynamicResource FL.TextDim}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="MinWidth" Value="40" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="MinHeight" Value="24" />
    </Style>
    <Style Selector="ToolTip">
      <Setter Property="MaxWidth" Value="720" />
    </Style>
    <Style Selector="TextBlock.header">
      <Setter Property="Foreground" Value="{DynamicResource FL.TextDim}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="{DynamicResource FL.Accent}" />
      <Setter Property="Foreground" Value="#1A1B1E" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F29A42" />
      <Setter Property="Foreground" Value="#1A1B1E" />
    </Style>
    <!-- ui-44 Kitbasher panel. -->
    <Style Selector="TextBlock.kblabel">
      <Setter Property="Foreground" Value="{DynamicResource FL.TextDim}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="Border.kbcard">
      <Setter Property="Background" Value="{DynamicResource FL.Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FL.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style Selector="Border.kbslot">
      <Setter Property="Background" Value="{DynamicResource FL.Panel}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="BorderThickness" Value="2,0,0,0" />
      <Setter Property="BorderBrush" Value="{DynamicResource FL.Border}" />
    </Style>
    <Style Selector="Border.kbslot.changed">
      <Setter Property="BorderBrush" Value="{DynamicResource FL.Accent}" />
    </Style>
    <Style Selector="Border.kbslot.empty">
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <!-- ui-43 Content Browser: type chips, small header buttons, asset tiles, the HEURISTIC badge. -->
    <Style Selector="ToggleButton.chip">
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="10,1" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="{DynamicResource FL.Panel}" />
    </Style>
    <Style Selector="ToggleButton.chip.model:checked /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="#4FA3E0" />
      <Setter Property="Background" Value="#334FA3E0" />
    </Style>
    <Style Selector="ToggleButton.chip.anim:checked /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="#57C27B" />
      <Setter Property="Background" Value="#3357C27B" />
    </Style>
    <Style Selector="ToggleButton.chip.fx:checked /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="#C77BE8" />
      <Setter Property="Background" Value="#33C77BE8" />
    </Style>
    <Style Selector="ToggleButton.chip.tex:checked /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="#D0574F" />
      <Setter Property="Background" Value="#33D0574F" />
    </Style>
    <Style Selector="Button.mini">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource FL.TextDim}" />
    </Style>
    <Style Selector="Border.tile">
      <Setter Property="Background" Value="{DynamicResource FL.Panel}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.tile.hover">
      <Setter Property="Background" Value="{DynamicResource FL.ControlHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FL.Border}" />
    </Style>
    <Style Selector="Border.tile.selected">
      <Setter Property="Background" Value="{DynamicResource FL.AccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FL.Accent}" />
    </Style>
    <Style Selector="ListBox.tiles ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.tiles ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.tiles ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.tiles ListBoxItem:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- mtl1-49 colour scheme picker -->
    <Style Selector="Border.colourpanel">
      <Setter Property="Background" Value="#E6191A1D" />
      <Setter Property="BorderBrush" Value="#55E8892B" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,9,14,10" />
      <Setter Property="BoxShadow" Value="0 6 18 0 #99000000" />
    </Style>
    <Style Selector="TextBlock.colourcaption">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.6" />
      <Setter Property="Foreground" Value="{DynamicResource FL.TextDim}" />
    </Style>
    <Style Selector="TextBlock.colourname">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="1.2" />
      <Setter Property="Foreground" Value="#F2E6D3" />
    </Style>
    <Style Selector="TextBlock.coloursub">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource FL.TextDim}" />
    </Style>
    <Style Selector="Button.swatch">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.swatch /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.swatch:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.swatch Ellipse.ring">
      <Setter Property="Stroke" Value="Transparent" />
      <Setter Property="StrokeThickness" Value="2" />
    </Style>
    <Style Selector="Button.swatch:pointerover Ellipse.ring">
      <Setter Property="Stroke" Value="#88DCDDDF" />
    </Style>
    <Style Selector="Button.swatch.selected Ellipse.ring">
      <Setter Property="Stroke" Value="{DynamicResource FL.Accent}" />
      <Setter Property="StrokeThickness" Value="2.5" />
    </Style>
    <Style Selector="Button.swatch Border.tick">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.swatch.selected Border.tick">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Button.colourstep">
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource FL.TextDim}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.hbadge">
      <Setter Property="Background" Value="#33E0C34F" />
      <Setter Property="BorderBrush" Value="#E0C34F" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="3,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Application.Styles>
</Application>

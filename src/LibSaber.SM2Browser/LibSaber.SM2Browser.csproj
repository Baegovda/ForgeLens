<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>LibSaber.SM2Browser</RootNamespace>
    <AssemblyName>ForgeLens</AssemblyName>
    <!-- R71 (t148u): the ONE app version source; bump with the HANDOFF ledger id (0.NN.0 = rNN). Shown in the title. -->
    <Version>0.82.0</Version>
    <!-- R74: workstation + concurrent GC (explicit), ConserveMemory lets the GC compact the LOH when it is fragmented. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <Product>Forge Lens</Product>
    <AssemblyTitle>Forge Lens</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LibSaber.SM2.Assets\LibSaber.SM2.Assets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.1" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.1" />
    <PackageReference Include="Avalonia.Controls.TreeDataGrid" Version="11.1.1" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.22.0" />
  </ItemGroup>

  <!-- R71: git short hash -> InformationalVersion "0.71.0+<hash>" (skipped silently when git is unavailable). -->
  <Target Name="ForgeLensGitHash" BeforeTargets="AddSourceRevisionToInformationalVersion;GetAssemblyVersion">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="ForgeLensGitHash" />
      <Output TaskParameter="ExitCode" PropertyName="ForgeLensGitExit" />
    </Exec>
    <PropertyGroup Condition="'$(ForgeLensGitExit)' == '0'">
      <SourceRevisionId>$(ForgeLensGitHash)</SourceRevisionId>
    </PropertyGroup>
  </Target>
</Project>

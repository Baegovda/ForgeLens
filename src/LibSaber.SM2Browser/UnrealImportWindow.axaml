<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LibSaber.SM2Browser.UnrealImportWindow"
        Title="Forge Lens — Direct to Unreal"
        Width="760" Height="460" MinWidth="480" MinHeight="260"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
      <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="15" Text="Importing into Unreal…" />
      <TextBlock x:Name="TargetText" Opacity="0.75" TextWrapping="Wrap" FontSize="12" />
      <ProgressBar x:Name="Bar" IsIndeterminate="True" Height="4" Margin="0,4,0,0" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button x:Name="OpenLogButton" Content="Open log folder" MinWidth="120" MinHeight="30" Click="OpenLogClicked" />
      <Button x:Name="CloseButton" Content="Close" MinWidth="96" MinHeight="30" Click="CloseClicked" />
    </StackPanel>
    <Border DockPanel.Dock="Bottom" x:Name="StatusBorder" Padding="8" CornerRadius="4" Margin="0,8,0,0" Background="#2A2D35">
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" Text="Starting…" />
    </Border>
    <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas,Menlo,DejaVu Sans Mono,monospace" FontSize="12" />
  </DockPanel>
</Window>

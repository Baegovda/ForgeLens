<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LibSaber.SM2Browser.ExportWindow"
        Title="Forge Lens — Export"
        Width="560"
        MinWidth="480"
        MinHeight="360"
        SizeToContent="Height"
        CanResize="True"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <Border DockPanel.Dock="Bottom" Padding="0,12,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
          <Button Content="Cancel" MinWidth="96" MinHeight="32" IsCancel="True" Click="CancelClicked" />
          <Button Content="Export" Classes="accent" MinWidth="96" MinHeight="32" IsDefault="True" Click="ExportClicked" />
        </StackPanel>
        <TextBlock x:Name="FolderError" DockPanel.Dock="Bottom" Foreground="#E85D4C" TextWrapping="Wrap" Margin="0,4,0,0" />
        <TextBlock DockPanel.Dock="Top" Text="Output folder" Margin="0,0,0,4" />
        <Button Content="Browse…" DockPanel.Dock="Right" MinWidth="96" MinHeight="32" Margin="8,0,0,0" Click="BrowseClicked" />
        <TextBox x:Name="FolderBox" MinHeight="32" Watermark="Folder for the exported files" />
      </DockPanel>
    </Border>
    <ScrollViewer x:Name="OptionsScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="8">
        <StackPanel x:Name="PartsPanel" Spacing="6" IsVisible="False" />
        <TextBlock TextWrapping="Wrap" Text="DDS keeps the original BC blocks. PNG and TGA are decoded images. glTF is Y-up meters. FBX follows the target below. Source units are meters, Y-up." />
        <ComboBox x:Name="SpaceBox" SelectedIndex="0">
          <ComboBoxItem Content="Unreal (FBX Z-up centimeters, x100)" />
          <ComboBoxItem Content="Blender (FBX Z-up meters)" />
        </ComboBox>
        <CheckBox x:Name="DdsBox" Content="Textures as DDS" IsChecked="True" />
        <CheckBox x:Name="PngBox" Content="Textures as PNG" IsChecked="True" />
        <CheckBox x:Name="TgaBox" Content="Textures as TGA" IsChecked="True" />
        <CheckBox x:Name="GltfBox" Content="Models and animations as glTF (.glb)" IsChecked="True" />
        <CheckBox x:Name="FbxBox" Content="Models as FBX" IsChecked="True" />
        <CheckBox x:Name="ModelTexturesBox" Content="Textures used by the model" IsChecked="True" />
        <CheckBox x:Name="MaterialBox" Content="Material slots as JSON" IsChecked="True" />
        <CheckBox x:Name="RawBox" Content="Also copy original bytes" />
        <CheckBox x:Name="ClothBox" Content="Include *_SIM cloth simulation meshes (the game never draws them)" />
        <TextBlock Text="Animations (anim-only FBX against the model's skeleton, plus ue_import_anim.py)" Margin="0,8,0,0" />
        <ComboBox x:Name="ClipBox" SelectedIndex="1">
          <ComboBoxItem Content="None (selected .sani export as .anim.json)" />
          <ComboBoxItem Content="Selected .sani rows, against the selected model" />
          <ComboBoxItem Content="The clip playing in the preview" />
          <ComboBoxItem Content="Every clip sharing the model's bone names" />
        </ComboBox>
        <CheckBox x:Name="MannyBox" Content="Anim Only (Manny): clips retargeted to the UE5 Mannequin (SK_Mannequin), {clip}_Manny.fbx" />
        <CheckBox x:Name="RootMotionBox" Content="Root motion (0xF4 track on the root)" IsChecked="True" />
        <TextBlock TextWrapping="Wrap" Opacity="0.75" Text="Effects (.ps, .sfx) are copied raw, with any texture or model names found inside them. Particle systems are not converted." />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
